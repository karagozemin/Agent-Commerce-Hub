# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
PAYMENT_PROVIDER=mock
# Comma-separated wallets whose activity is excluded from external metrics.
INTERNAL_WALLETS=
DATA_STORE=memory
DATABASE_URL=postgresql://agenthub:agenthub@localhost:5432/agenthub
# Set POSTGRES_PORT=5433 if port 5432 is already in use, and match DATABASE_URL.
CREDENTIAL_ENCRYPTION_KEY=
# Generate a 32-byte base64 key: openssl rand -base64 32

# GOAT Flow (required when PAYMENT_PROVIDER=goat-flow)
GOATX402_API_URL=https://flow-api.testnet3.goat.network
GOATX402_API_KEY=
GOATX402_API_SECRET=
# Required for first-party mainnet services; must match the merchant DIRECT route.
GOATX402_RECEIVING_WALLET=
GOAT_QUICKPAY_ORIGIN=https://flow-quickpay.goat.network
GOAT_QUICKPAY_MERCHANT_ID=agentcommercehub
GOAT_QUICKPAY_PRODUCT_KEY=wallet-analysis
GOAT_NETWORK=goat-testnet
GOAT_CHAIN_ID=48816
GOAT_RPC_URL=https://rpc.testnet3.goat.network
GOAT_TRACKING_RPC_URL=https://rpc.ankr.com/goat_mainnet
GOAT_EXPLORER_URL=https://explorer.testnet3.goat.network

# Mainnet values for production:
# GOATX402_API_URL=https://flow-api.goat.network
# GOAT_NETWORK=goat-mainnet
# GOAT_CHAIN_ID=2345
# GOAT_RPC_URL=https://rpc.goat.network
# GOAT_TRACKING_RPC_URL=https://rpc.ankr.com/goat_mainnet
# GOAT_EXPLORER_URL=https://explorer.goat.network
